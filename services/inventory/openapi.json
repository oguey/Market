{
  "openapi": "3.1.0",
  "info": {
    "title": "Market - Inventory",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/warehouses": {
      "get": {
        "tags": [
          "warehouses"
        ],
        "summary": "Warehouses",
        "operationId": "warehouses_v1_warehouses_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Warehouse"
                  },
                  "type": "array",
                  "title": "Response Warehouses V1 Warehouses Get"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/v1/inventory/{product_id}": {
      "get": {
        "tags": [
          "stock"
        ],
        "summary": "Get Stock",
        "operationId": "get_stock_v1_inventory__product_id__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "product_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Product Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductStock"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "stock"
        ],
        "summary": "Set Stock",
        "description": "Sets the available quantity of a product in one warehouse (creates the line if needed).",
        "operationId": "set_stock_v1_inventory__product_id__put",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "product_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Product Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StockIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductStock"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/reservations": {
      "post": {
        "tags": [
          "reservations"
        ],
        "summary": "Reserve",
        "description": "All-or-nothing, idempotent on order_id: a replay never reserves twice.",
        "operationId": "reserve_v1_reservations_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReservationIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Reservation"
                }
              }
            }
          },
          "200": {
            "description": "Already reserved (idempotent replay)"
          },
          "409": {
            "description": "Insufficient stock"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/v1/reservations/{order_id}": {
      "get": {
        "tags": [
          "reservations"
        ],
        "summary": "Get Reservation",
        "operationId": "get_reservation_v1_reservations__order_id__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "order_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Order Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Reservation"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/reservations/{order_id}/release": {
      "post": {
        "tags": [
          "reservations"
        ],
        "summary": "Release",
        "description": "Saga compensation: returns the reserved stock. Idempotent.",
        "operationId": "release_v1_reservations__order_id__release_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "order_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Order Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Reservation"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/reservations/{order_id}/confirm": {
      "post": {
        "tags": [
          "reservations"
        ],
        "summary": "Confirm",
        "description": "Order paid: the reservation becomes final. Idempotent.",
        "operationId": "confirm_v1_reservations__order_id__confirm_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "order_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Order Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Reservation"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Line": {
        "properties": {
          "product_id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Product Id"
          },
          "quantity": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Quantity"
          }
        },
        "type": "object",
        "required": [
          "product_id",
          "quantity"
        ],
        "title": "Line"
      },
      "ProductStock": {
        "properties": {
          "product_id": {
            "type": "integer",
            "title": "Product Id"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "warehouses": {
            "items": {
              "$ref": "#/components/schemas/StockIn"
            },
            "type": "array",
            "title": "Warehouses"
          }
        },
        "type": "object",
        "required": [
          "product_id",
          "total",
          "warehouses"
        ],
        "title": "ProductStock"
      },
      "Reservation": {
        "properties": {
          "order_id": {
            "type": "integer",
            "title": "Order Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/ReservedLine"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "order_id",
          "status",
          "items"
        ],
        "title": "Reservation"
      },
      "ReservationIn": {
        "properties": {
          "order_id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Order Id"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/Line"
            },
            "type": "array",
            "minItems": 1,
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "order_id",
          "items"
        ],
        "title": "ReservationIn"
      },
      "ReservedLine": {
        "properties": {
          "product_id": {
            "type": "integer",
            "title": "Product Id"
          },
          "warehouse_id": {
            "type": "integer",
            "title": "Warehouse Id"
          },
          "quantity": {
            "type": "integer",
            "title": "Quantity"
          }
        },
        "type": "object",
        "required": [
          "product_id",
          "warehouse_id",
          "quantity"
        ],
        "title": "ReservedLine"
      },
      "StockIn": {
        "properties": {
          "warehouse_id": {
            "type": "integer",
            "title": "Warehouse Id"
          },
          "quantity": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Quantity"
          }
        },
        "type": "object",
        "required": [
          "warehouse_id",
          "quantity"
        ],
        "title": "StockIn"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "Warehouse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "capacity_units": {
            "type": "integer",
            "title": "Capacity Units"
          },
          "stored_units": {
            "type": "integer",
            "title": "Stored Units"
          },
          "fill_rate": {
            "type": "number",
            "title": "Fill Rate"
          },
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "capacity_units",
          "stored_units",
          "fill_rate",
          "status"
        ],
        "title": "Warehouse"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
